# Configuración del servicio de recomendación (copiar a .env y ajustar)

# Modelo de recomendación activo:
#   rule_based | most_popular | content_based | kg_rules | bpr_mf | neumf | feature_aware_neumf
RECO_MODEL=content_based

# Backend del grafo pedagógico: inmemory (default) | neo4j
GRAPH_BACKEND=inmemory

# Neo4j (solo si GRAPH_BACKEND=neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# CORS: orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Ruta al artefacto del modelo (checkpoint) para los modelos ML
MODEL_ARTIFACT_PATH=models/
